# Line endings: Git stores text with LF; launchers keep the endings their
# operating system needs, whatever computer they are checked out on.
* text=auto
*.bat text eol=crlf
*.command text eol=lf
*.sh text eol=lf
*.py text eol=lf

# Binary files
*.png binary
*.jpg binary
*.mp3 binary
*.wav binary
*.mp4 binary
*.onnx binary
*.zip binary
